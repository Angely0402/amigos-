    respuestas: ["¡Hola! ¿Cocinas o solo comes? 😂", "Te preparo algo cuando nos veamos.", "En carnaval no hay quien me gane bailando."] },
  { id: 12, nombre: "Nicolás Díaz", edad: 25, ciudad: "Cartagena", distancia: 5, ocupacion: "Community manager",
    busca: "Planes de cine, fútbol y viajes cortos.",
    bio: "Cinéfilo y futbolero. Siempre listo para un plan improvisado.",
    intereses: ["Fútbol", "Cine", "Viajes"], emoji: ["⚽", "🎥", "🧳"], colores: ["#3d8bff", "#7c5cff"], likeBack: true,
    respuestas: ["¡Hola! ¿Qué tal todo?", "¿Viste el partido de anoche?", "Vamos a cine esta semana, yo escojo la peli 🎥"] }
];

// Intereses del usuario (para resaltar coincidencias). Cámbialos para probar.
const MIS_INTERESES = ["Música", "Viajes", "Videojuegos", "Cine"];

const RESPUESTAS_GENERICAS = [
  "Jaja qué bueno 😄", "Cuéntame más", "Me encantaría, ¿qué día te queda bien?", "Totalmente de acuerdo 🙌"
];

const UMBRAL = 110; // píxeles que hay que arrastrar para decidir

/* =========================================================
   ESTADO (se guarda en localStorage)
   ========================================================= */
const CLAVE = "amigo-demo-v2";

function estadoVacio() {
  return { vistos: {}, matches: [], chats: {}, noLeidos: {} };
}

function cargar() {
  try {
    const raw = localStorage.getItem(CLAVE);
    if (raw) {
      const d = JSON.parse(raw);
      return {
        vistos: d.vistos || {},
        matches: d.matches || [],
        chats: d.chats || {},
        noLeidos: d.noLeidos || {}
      };
    }
  } catch (e) { /* sin almacenamiento disponible */ }
  return estadoVacio();
}

function guardar() {
  try { localStorage.setItem(CLAVE, JSON.stringify(estado)); } catch (e) { /* ignorar */ }
}

let estado = cargar();
let ultima = null;          // última acción (para deshacer)
let animando = false;       // evita decidir dos veces durante la animación
let vistaActual = "descubrir";
let chatActual = null;      // id del chat abierto
let escribiendoId = null;   // id de quien está "escribiendo"
let detallePerfil = null;
let detalleCtx = "deck";
let fotoIdx = 0;
let matchActual = null;

/* =========================================================
   REFERENCIAS AL DOM
   ========================================================= */
const $ = id => document.getElementById(id);
const $app = $("app");
const $deck = $("deck");
const $deckVacio = $("deck-vacio");
const $acciones = $("acciones");
const $btnDeshacer = $("btn-deshacer");
const $listaMatches = $("lista-matches");
const $matchesVacio = $("matches-vacio");
const $matchesSub = $("matches-sub");
const $badge = $("badge-matches");
const $mensajes = $("mensajes");
const $chatPersona = $("chat-persona");
const $chatInput = $("chat-input");
const $modal = $("modal-detalle");
const $overlay = $("overlay-match");

/* =========================================================
   UTILIDADES
   ========================================================= */
const perfilPorId = id => perfiles.find(p => p.id === id);
const cola = () => perfiles.filter(p => !estado.vistos[p.id]);
const horaActual = () => new Date().toLocaleTimeString("es-CO", { hour: "2-digit", minute: "2-digit" });

function fondo(p, i) {
  const [a, b] = p.colores;
  const ang = [135, 210, 320][i % 3];
  return i % 2 === 1
    ? `linear-gradient(${ang}deg, ${b}, ${a})`
    : `linear-gradient(${ang}deg, ${a}, ${b})`;
}

function crearAvatar(p, clase) {
  const d = document.createElement("div");
  d.className = "avatar " + (clase || "");
  d.style.background = fondo(p, 0);
  d.textContent = p.emoji[0];
  return d;
}

function tagsHTML(p, max) {
  const lista = max ? p.intereses.slice(0, max) : p.intereses;
  return lista.map(i =>
    `<span class="tag${MIS_INTERESES.includes(i) ? " en-comun" : ""}">${i}</span>`
  ).join("");
}

function interesComun(p) {
  return p.intereses.find(i => MIS_INTERESES.includes(i)) || p.intereses[0];
}

/* =========================================================
   DECK DE TARJETAS
   ========================================================= */
function crearTarjeta(p, pos) {
  const c = document.createElement("article");
  c.className = "tarjeta pos-" + pos;
  c.dataset.id = p.id;
  c.style.background = fondo(p, 0);
  c.innerHTML = `
    <div class="tarjeta-emoji">${p.emoji[0]}</div>
    <div class="sello sello-like">LIKE</div>
    <div class="sello sello-nope">NOPE</div>
    <div class="tarjeta-info">
      <h3>${p.nombre.split(" ")[0]}<span>${p.edad}</span></h3>
      <div class="meta">${p.ocupacion} · ${p.ciudad} · a ${p.distancia} km</div>
      <div class="tags">${tagsHTML(p, 3)}</div>
    </div>
  `;
  return c;
}

function renderDeck() {
  $deck.innerHTML = "";
  const pendientes = cola();
  const hay = pendientes.length > 0;

  $deck.classList.toggle("oculto", !hay);
  $deckVacio.classList.toggle("oculto", hay);
  $acciones.classList.toggle("oculto", !hay);

  // Se agrega de atrás hacia adelante: la de arriba queda al final
  pendientes.slice(0, 3).reverse().forEach((p, idx, arr) => {
    const pos = arr.length - 1 - idx;
    $deck.appendChild(crearTarjeta(p, pos));
  });

  const top = $deck.lastElementChild;
  if (top) activarArrastre(top);
  $btnDeshacer.disabled = !ultima;
}

function activarArrastre(card) {
  const id = Number(card.dataset.id);
  const sLike = card.querySelector(".sello-like");
  const sNope = card.querySelector(".sello-nope");
  let sx = 0, sy = 0, dx = 0, activo = false, movido = false;

  card.addEventListener("pointerdown", e => {
    if (animando) return;
    activo = true;
    movido = false;
    dx = 0;
    sx = e.clientX;
    sy = e.clientY;
    card.setPointerCapture(e.pointerId);
    card.classList.add("arrastrando");
  });

  card.addEventListener("pointermove", e => {
    if (!activo) return;
    dx = e.clientX - sx;
    const dy = e.clientY - sy;
    if (Math.abs(dx) > 6 || Math.abs(dy) > 6) movido = true;
    card.style.transform = `translate(${dx}px, ${dy}px) rotate(${dx / 18}deg)`;
    const t = Math.min(1, Math.abs(dx) / UMBRAL);
    sLike.style.opacity = dx > 0 ? t : 0;
    sNope.style.opacity = dx < 0 ? t : 0;
  });

  const soltar = () => {
    if (!activo) return;
    activo = false;
    card.classList.remove("arrastrando");

    if (!movido) {                       // un toque simple abre el perfil
      abrirDetalle(id, "deck");
    } else if (dx > UMBRAL) {
      decidir("like");
    } else if (dx < -UMBRAL) {
      decidir("nope");
    } else {                             // no llegó al umbral: vuelve al centro
      card.style.transform = "";
      sLike.style.opacity = 0;
      sNope.style.opacity = 0;
    }
    dx = 0;
  };
  card.addEventListener("pointerup", soltar);
  card.addEventListener("pointercancel", soltar);
}

function decidir(accion) {
  if (animando) return;
  const top = $deck.lastElementChild;
  if (!top) return;

  animando = true;
  const id = Number(top.dataset.id);
  const dir = accion === "like" ? 1 : -1;

  top.classList.remove("arrastrando");
  top.classList.add("saliendo");
  top.querySelector(accion === "like" ? ".sello-like" : ".sello-nope").style.opacity = 1;
  top.style.transform = `translate(${dir * 520}px, -40px) rotate(${dir * 28}deg)`;
  top.style.opacity = "0";

  setTimeout(() => {
    procesar(id, accion);
    animando = false;
  }, 320);
}

function procesar(id, accion) {
  estado.vistos[id] = accion;
  const p = perfilPorId(id);
  let hayMatch = false;

  if (accion === "like" && p.likeBack) {
    hayMatch = true;
    if (!estado.matches.includes(id)) estado.matches.unshift(id);
    estado.chats[id] = estado.chats[id] || [];
  }

  ultima = hayMatch ? null : { id, accion };
  guardar();
  renderDeck();
  actualizarBadge();
  if (hayMatch) mostrarMatch(p);
}

function deshacer() {
  if (!ultima || animando) return;
  delete estado.vistos[ultima.id];
  ultima = null;
  guardar();
  renderDeck();
}

/* =========================================================
   MATCH
   ========================================================= */
function mostrarMatch(p) {
  matchActual = p.id;
  $("match-texto").textContent = `Tú y ${p.nombre.split(" ")[0]} se gustaron.`;
  const yo = $("match-yo");
  yo.style.background = "linear-gradient(135deg, #7c5cff, #3ddbd9)";
  yo.textContent = "🙂";
  const otro = $("match-otro");
  otro.style.background = fondo(p, 0);
  otro.textContent = p.emoji[0];
  $overlay.classList.remove("oculto");
}

function cerrarMatch(irAlChat) {
  $overlay.classList.add("oculto");
  const id = matchActual;
  if (irAlChat) {
    abrirChat(id);
  } else {
    programarSaludo(id);
  }
}

// Si el usuario sigue descubriendo, la persona escribe primero a los pocos segundos
function programarSaludo(id) {
  setTimeout(() => {
    const msgs = estado.chats[id] || [];
    if (msgs.length > 0) return;
    const p = perfilPorId(id);
    recibirMensaje(id, `¡Hola! Vi que también te gusta ${interesComun(p)}. ¿Qué tal? 👋`);
  }, 3500);
}

/* =========================================================
   VISTAS Y NAVEGACIÓN
   ========================================================= */
function mostrarVista(nombre) {
  vistaActual = nombre;
  ["descubrir", "matches", "chat"].forEach(v =>
    $("vista-" + v).classList.toggle("activa", v === nombre)
  );
  document.querySelectorAll(".nav-btn").forEach(b =>
    b.classList.toggle("activo", b.dataset.vista === (nombre === "chat" ? "matches" : nombre))
  );
  $app.classList.toggle("en-chat", nombre === "chat");
  if (nombre === "matches") renderMatches();
}

function actualizarBadge() {
  const total = Object.values(estado.noLeidos).reduce((a, b) => a + b, 0);
  $badge.textContent = total;
  $badge.classList.toggle("oculto", total === 0);
}

/* =========================================================
   LISTA DE MATCHES
   ========================================================= */
function renderMatches() {
  $listaMatches.innerHTML = "";
  const n = estado.matches.length;
  $matchesVacio.classList.toggle("oculto", n > 0);
  $matchesSub.textContent = n === 0 ? "" : `${n} ${n === 1 ? "persona" : "personas"} con las que puedes hablar`;

  estado.matches.forEach(id => {
    const p = perfilPorId(id);
    const msgs = estado.chats[id] || [];
    const ultimo = msgs[msgs.length - 1];
    const sinLeer = (estado.noLeidos[id] || 0) > 0;

    const item = document.createElement("button");
    item.className = "match-item" + (sinLeer ? " sin-leer" : "");

    const av = crearAvatar(p);
    av.addEventListener("click", e => { e.stopPropagation(); abrirDetalle(id, "match"); });
    av.setAttribute("role", "button");
    av.title = "Ver perfil";

    const datos = document.createElement("div");
    datos.className = "match-datos";
    const nombre = document.createElement("div");
    nombre.className = "match-nombre";
    nombre.textContent = p.nombre;
    const prev = document.createElement("div");
    prev.className = "match-preview";
    prev.textContent = ultimo ? (ultimo.de === "yo" ? "Tú: " : "") + ultimo.texto : "¡Es un match! Di hola 👋";
    datos.append(nombre, prev);

    item.append(av, datos);
    if (sinLeer) {
      const punto = document.createElement("span");
      punto.className = "punto";
      item.appendChild(punto);
    }
    item.addEventListener("click", () => abrirChat(id));
    $listaMatches.appendChild(item);
  });
}

/* =========================================================
   CHAT
   ========================================================= */
function abrirChat(id) {
  chatActual = id;
  estado.noLeidos[id] = 0;
  guardar();
  actualizarBadge();

  const p = perfilPorId(id);
  $chatPersona.innerHTML = "";
  const nombre = document.createElement("span");
  nombre.textContent = p.nombre;
  $chatPersona.append(crearAvatar(p, "mini"), nombre);

  renderMensajes();
  mostrarVista("chat");
}

function renderMensajes() {
  $mensajes.innerHTML = "";
  const msgs = estado.chats[chatActual] || [];
  const p = perfilPorId(chatActual);

  if (msgs.length === 0) {
    const nota = document.createElement("div");
    nota.className = "nota-chat";
    nota.textContent = `Hiciste match con ${p.nombre.split(" ")[0]}. ¡Rompe el hielo!`;
    $mensajes.appendChild(nota);
  }

  msgs.forEach(m => {
    const b = document.createElement("div");
    b.className = "burbuja " + m.de;
    b.textContent = m.texto;
    const h = document.createElement("small");
    h.textContent = m.hora;
    b.appendChild(h);
    $mensajes.appendChild(b);
  });

  if (escribiendoId === chatActual) {
    const t = document.createElement("div");
    t.className = "burbuja ellos escribiendo";
    t.innerHTML = "<i></i><i></i><i></i>";
    $mensajes.appendChild(t);
  }
  $mensajes.scrollTop = $mensajes.scrollHeight;
}

function recibirMensaje(id, texto) {
  estado.chats[id] = estado.chats[id] || [];
  estado.chats[id].push({ de: "ellos", texto, hora: horaActual() });

  const viendo = vistaActual === "chat" && chatActual === id;
  if (!viendo) estado.noLeidos[id] = (estado.noLeidos[id] || 0) + 1;
  guardar();
  actualizarBadge();

  if (viendo) renderMensajes();
  else if (vistaActual === "matches") renderMatches();
}

function enviarMensaje(texto) {
  const id = chatActual;
  estado.chats[id].push({ de: "yo", texto, hora: horaActual() });
  guardar();
  renderMensajes();
  responder(id);
}

function responder(id) {
  if (escribiendoId === id) return; // ya está escribiendo
  const p = perfilPorId(id);
  const previas = estado.chats[id].filter(m => m.de === "ellos").length;
  const texto = p.respuestas[previas] || RESPUESTAS_GENERICAS[previas % RESPUESTAS_GENERICAS.length];

  setTimeout(() => {
    escribiendoId = id;
    if (vistaActual === "chat" && chatActual === id) renderMensajes();
    setTimeout(() => {
      escribiendoId = null;
      recibirMensaje(id, texto);
    }, 1100 + Math.random() * 900);
  }, 600);
}

/* =========================================================
   PERFIL DETALLADO
   ========================================================= */
function abrirDetalle(id, ctx) {
  detallePerfil = perfilPorId(id);
  detalleCtx = ctx;
  fotoIdx = 0;
  const p = detallePerfil;

  $("d-nombre").innerHTML = `${p.nombre}<span>${p.edad}</span>`;
  $("d-ocupacion").textContent = p.ocupacion;
  $("d-ciudad").textContent = `${p.ciudad} · a ${p.distancia} km de ti`;
  $("d-bio").textContent = p.bio;
  $("d-busca").textContent = p.busca;
  $("d-tags").innerHTML = tagsHTML(p);

  const acc = $("d-acciones");
  acc.innerHTML = "";
  if (ctx === "deck") {
    const no = document.createElement("button");
    no.className = "accion nope";
    no.textContent = "✕";
    no.setAttribute("aria-label", "No me interesa");
    no.addEventListener("click", () => { cerrarDetalle(); decidir("nope"); });

    const si = document.createElement("button");
    si.className = "accion like";
    si.textContent = "♥";
    si.setAttribute("aria-label", "Me gusta");
    si.addEventListener("click", () => { cerrarDetalle(); decidir("like"); });
    acc.append(no, si);
  } else {
    const msg = document.createElement("button");
    msg.className = "btn btn-primario ancho";
    msg.textContent = "Enviar mensaje";
    msg.addEventListener("click", () => { cerrarDetalle(); abrirChat(p.id); });
    acc.appendChild(msg);
  }

  renderFoto();
  $modal.classList.remove("oculto");
}

function renderFoto() {
  const p = detallePerfil;
  $("galeria-foto").style.background = fondo(p, fotoIdx);
  $("galeria-emoji").textContent = p.emoji[fotoIdx];
  const barras = $("galeria-barras");
  barras.innerHTML = "";
  p.emoji.forEach((_, i) => {
    const s = document.createElement("span");
    if (i === fotoIdx) s.className = "on";
    barras.appendChild(s);
  });
}

function cambiarFoto(delta) {
  const n = detallePerfil.emoji.length;
  fotoIdx = Math.max(0, Math.min(n - 1, fotoIdx + delta));
  renderFoto();
}

function cerrarDetalle() {
  $modal.classList.add("oculto");
}

/* =========================================================
   REINICIAR
   ========================================================= */
function reiniciar() {
  if (!confirm("¿Reiniciar la demo? Se borrarán tus matches y mensajes.")) return;
  estado = estadoVacio();
  ultima = null;
  chatActual = null;
  escribiendoId = null;
  guardar();
  renderDeck();
  actualizarBadge();
  mostrarVista("descubrir");
}

/* =========================================================
   EVENTOS
   ========================================================= */
$("btn-like").addEventListener("click", () => decidir("like"));
$("btn-nope").addEventListener("click", () => decidir("nope"));
$btnDeshacer.addEventListener("click", deshacer);
$("btn-info").addEventListener("click", () => {
  const top = $deck.lastElementChild;
  if (top) abrirDetalle(Number(top.dataset.id), "deck");
});

$("btn-reiniciar").addEventListener("click", reiniciar);
$("btn-reiniciar-vacio").addEventListener("click", reiniciar);

document.querySelectorAll(".nav-btn").forEach(b =>
  b.addEventListener("click", () => mostrarVista(b.dataset.vista))
);

$("chat-atras").addEventListener("click", () => { chatActual = null; mostrarVista("matches"); });
$chatPersona.addEventListener("click", () => { if (chatActual) abrirDetalle(chatActual, "match"); });

$("chat-form").addEventListener("submit", e => {
  e.preventDefault();
  const texto = $chatInput.value.trim();
  if (!texto || !chatActual) return;
  $chatInput.value = "";
  enviarMensaje(texto);
});

$("gal-prev").addEventListener("click", () => cambiarFoto(-1));
$("gal-next").addEventListener("click", () => cambiarFoto(1));
$("detalle-cerrar").addEventListener("click", cerrarDetalle);
$modal.addEventListener("click", e => { if (e.target === $modal) cerrarDetalle(); });

$("match-mensaje").addEventListener("click", () => cerrarMatch(true));
$("match-seguir").addEventListener("click", () => cerrarMatch(false));

document.addEventListener("keydown", e => {
  const modalAbierto = !$modal.classList.contains("oculto");
  const overlayAbierto = !$overlay.classList.contains("oculto");

  if (e.key === "Escape") {
    if (modalAbierto) cerrarDetalle();
    else if (overlayAbierto) cerrarMatch(false);
    return;
  }
  if (modalAbierto) {
    if (e.key === "ArrowLeft") cambiarFoto(-1);
    if (e.key === "ArrowRight") cambiarFoto(1);
    return;
  }
  if (overlayAbierto || vistaActual !== "descubrir") return;
  if (e.key === "ArrowRight") decidir("like");
  if (e.key === "ArrowLeft") decidir("nope");
});

/* =========================================================
   ARRANQUE
   ========================================================= */
renderDeck();
actualizarBadge();
